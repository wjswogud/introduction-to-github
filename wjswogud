import time
import os

def print_triangle(width):
    """삼각형 출력 함수"""
    # 직삼각형
    for i in range(1, width + 1):
        print(' ' * (width - i) + '*' * i)
    
    # 역직삼각형
    for i in range(width - 1, 0, -1):
        print(' ' * (width - i) + '*' * i)

def splash_screen(name, date):
    """스플래시 화면 출력"""
    print('+' + '-' * 77 + '+')
    print(' ' * 5 + '풀 한 포기 없는 황무지에서 반짝이는 행성을 만들내는 곳 마그라테아,')
    print(' ' * 5 + '사람들이 보지 못하는 잠재력을 찾고 전문가의 손길을 더해 보석을 빗는 곳,')
    print(' ' * 5 + '마그라테아에 오신걸 환영합니다.')
    print('+' + '-' * 77 + '+')
    print(f"[사용자]: {name}                                   [실행 시간]:{date}")
    print('=' * 80)

def main():
    # 날짜와 이름 입력 받기
    date = input("[현재 날짜를 'yyyy-mm-dd' 형식으로 입력하세요]: ")
    name = input("[당신의 이름을 입력하세요]: ")
    
    # 입력 확인 메시지
    print("**입력이 정상적으로 처리되었습니다.**")
    
    # 3초 기다린 후 화면을 지우고 새로운 스플래시 화면 출력
    time.sleep(3)
    
    # 화면 지우기 (운영체제에 맞는 방법으로)
    os.system('cls' if os.name == 'nt' else 'clear')
    
    # 스플래시 화면 출력
    print_triangle(5)  # 삼각형 크기 설정
    splash_screen(name, date)
    print_triangle(5)

if __name__ == "__main__":
    main()
